# Arch Linux bare-metal RISC-V prefix
PREFIX = riscv64-elf-
CC = $(PREFIX)gcc
OBJCOPY = $(PREFIX)objcopy

# Flags for a 32-bit RISC-V with a Multiplier (rv32im)
ARCH = -march=rv32im_zicsr -mabi=ilp32
CFLAGS = $(ARCH) -ffreestanding -nostdlib -O2
LDFLAGS = -T link.ld

all: firmware.hex

firmware.elf: crt0.S main.c
	$(CC) $(CFLAGS) $(LDFLAGS) $^ -o $@

firmware.hex: firmware.elf
	$(OBJCOPY) -O verilog $< $@

clean:
	rm -f firmware.elf firmware.hex
